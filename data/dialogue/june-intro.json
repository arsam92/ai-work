{
  "dialogueId": "june-intro",
  "npcId": "june",
  "startNodeId": "start",
  "nodes": {
    "start": {
      "id": "start",
      "speakerId": "june",
      "text": "Elias? ...I knew the city would drag you back eventually.",
      "tone": "guarded",
      "animationIntent": "nervous",
      "choices": [
        {
          "id": "calm",
          "text": "I need to talk. Something happened to Jonah.",
          "nextNodeId": "jonah",
          "effects": [
            { "type": "change_relationship", "payload": { "targetId": "player", "delta": { "trust": 0.05, "suspicion": -0.05 } } },
            { "type": "add_memory", "payload": { "eventType": "DIALOGUE", "description": "Elias came back asking about Jonah, calm and serious.", "emotion": "concern", "intensity": 0.4, "confidence": 0.9, "importance": 0.55 } }
          ]
        },
        {
          "id": "pressure",
          "text": "Someone searched your garage. What are you hiding?",
          "nextNodeId": "pressure",
          "effects": [
            { "type": "change_relationship", "payload": { "targetId": "player", "delta": { "suspicion": 0.15, "anger": 0.1 } } },
            { "type": "add_memory", "payload": { "eventType": "DIALOGUE", "description": "Elias accused me of hiding something and demanded answers.", "emotion": "wary", "intensity": 0.5, "confidence": 0.9, "importance": 0.6 } }
          ]
        }
      ]
    },
    "jonah": {
      "id": "jonah",
      "speakerId": "june",
      "text": "Jonah came here two nights ago. He asked about an old set of keys. Then somebody came looking for the same thing.",
      "tone": "concerned",
      "animationIntent": "nervous",
      "choices": [
        { "id": "ask-keys", "text": "What keys?", "nextNodeId": "keys", "effects": [] },
        {
          "id": "promise",
          "text": "I'll keep you out of this. Tell me what you know.",
          "nextNodeId": "keys",
          "effects": [
            { "type": "set_flag", "payload": { "key": "june_promise_made", "value": true } },
            { "type": "change_relationship", "payload": { "targetId": "player", "delta": { "trust": 0.1, "affection": 0.05 } } },
            { "type": "add_memory", "payload": { "eventType": "DIALOGUE", "description": "Elias promised to keep me out of this.", "emotion": "warmth", "intensity": 0.45, "confidence": 0.95, "importance": 0.7 } },
            { "type": "custom", "payload": { "action": "npc_promise", "promiseId": "june-promise-protection", "content": "Elias promised to keep June out of the investigation." } }
          ]
        }
      ]
    },
    "pressure": {
      "id": "pressure",
      "speakerId": "june",
      "text": "You disappear for years, come back angry, and start asking questions like you still own this place? No. Slow down.",
      "tone": "angry",
      "animationIntent": "step_back",
      "choices": [
        {
          "id": "apologize",
          "text": "You're right. I should have asked first.",
          "nextNodeId": "jonah",
          "effects": [
            { "type": "change_relationship", "payload": { "targetId": "player", "delta": { "anger": -0.1 } } },
            { "type": "add_memory", "payload": { "eventType": "DIALOGUE", "description": "Elias apologized for pressuring me.", "emotion": "relief", "intensity": 0.3, "confidence": 0.9, "importance": 0.45 } }
          ]
        },
        {
          "id": "leave",
          "text": "Fine. I'll find the answers somewhere else.",
          "nextNodeId": null,
          "effects": [
            { "type": "change_relationship", "payload": { "targetId": "player", "delta": { "suspicion": 0.05 } } },
            { "type": "add_memory", "payload": { "eventType": "DIALOGUE", "description": "Elias walked off angry, saying he'd find answers elsewhere.", "emotion": "wary", "intensity": 0.35, "confidence": 0.9, "importance": 0.45 } }
          ]
        }
      ]
    },
    "keys": {
      "id": "keys",
      "speakerId": "june",
      "text": "Old ignition keys. They belonged to a delivery van tied to Black Mile. Jonah said one of them opens a storage cage.",
      "tone": "quiet",
      "animationIntent": "avoid_eye_contact",
      "choices": [
        {
          "id": "where",
          "text": "Where is the cage?",
          "nextNodeId": "end",
          "effects": [
            { "type": "set_flag", "payload": { "key": "june_old_keys_lead", "value": true } },
            { "type": "add_memory", "payload": { "eventType": "DIALOGUE", "description": "I told Elias about the storage cage behind the railway yard.", "emotion": "wary", "intensity": 0.4, "confidence": 0.95, "importance": 0.65 } }
          ]
        }
      ]
    },
    "end": {
      "id": "end",
      "speakerId": "june",
      "text": "Behind the railway yard. And Elias... don't make me regret helping you again.",
      "tone": "worried",
      "animationIntent": "avoid_eye_contact",
      "choices": [
        { "id": "goodbye", "text": "I won't.", "nextNodeId": null, "effects": [] }
      ]
    }
  }
}
